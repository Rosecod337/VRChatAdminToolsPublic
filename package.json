{
  "name": "vrchat-admin-tools-source",
  "version": "2.0.0-beta.3",
  "private": true,
  "description": "Исходный код Windows-приложений VRChat Admin Tools и совместимого серверного шаблона.",
  "license": "AGPL-3.0-only",
  "workspaces": [
    "apps/client",
    "apps/client-beta",
    "packages/*",
    "server-template"
  ],
  "scripts": {
    "server:dev": "node server-template/src/index.js",
    "server:start": "node server-template/src/index.js",
    "client:dev": "electron apps/client",
    "client-beta:dev": "electron apps/client-beta",
    "check:client-beta:performance": "node scripts/check-beta-renderer-performance.mjs",
    "check:client-beta:i18n": "node scripts/check-beta-i18n.mjs",
    "test": "node --test tests/*.test.js tests/*-test.js",
    "build:client": "node scripts/build-electron.mjs client",
    "build:client-beta": "node scripts/build-electron.mjs client-beta",
    "build:all": "npm run test && npm run build:client && npm run build:client-beta",
    "release:check": "node scripts/verify-release.mjs"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "electron": "^42.9.3",
    "electron-builder": "^26.15.2",
    "javascript-obfuscator": "^5.4.3"
  }
}
